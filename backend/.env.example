# Server-only environment variables. Never commit backend/.env.
PORT=5000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GEMINI_API_KEY=your_gemini_api_key
VITE_MAPBOX_TOKEN=your_mapbox_public_token
# Required to send password recovery codes.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login
SMTP_PASS=your_smtp_key
MAIL_FROM="West Rand Judo Association" <your_sender_address>
MAIL_REPLY_TO=your_reply_address
PUBLIC_SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
