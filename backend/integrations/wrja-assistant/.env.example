# Copy this file to .env for local development and add your own key there.
# Never place the key in client-side Vite variables such as VITE_GEMINI_API_KEY.
# WITHOUT a key the assistant runs in basic offline mode (works, but far less natural).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_MS=20000
PORT=3000
# llm-first (default): every message goes to Gemini with all WRJA facts + the conversation.
# local-first: confident first-turn answers skip Gemini (cheaper, less conversational).
ASSISTANT_STRATEGY=llm-first
# Behind a reverse proxy / CDN, set to the number of proxy hops (e.g. 1) so rate limiting sees real visitor IPs.
TRUST_PROXY=
