diff --git a/backend/src/integrations/pushNotifications.js b/backend/src/integrations/pushNotifications.js
new file mode 100644
--- /dev/null
+++ b/backend/src/integrations/pushNotifications.js
@@ -0,0 +1,102 @@
+// Server-only FCM HTTP v1 sender. Supabase remains the content database.
+import { createSign } from "node:crypto";
+
+const TOPIC = "wrja-public-updates";
+const TOKEN_URL = "https://oauth2.googleapis.com/token";
+let cachedToken = null;
+let tokenRequest = null;
+
+export function buildPublicationMessage(kind, item) {
+  if (!["event", "news"].includes(kind)) throw new Error("Unsupported publication type");
+  const id = String(item.id || "");
+  const title = String(item.title || item.name || "WRJA update").trim();
+  if (!id || !title) throw new Error("Publication ID and title are required");
+  const headings = kind === "news"
+    ? ["New WRJA news", "Nuwe WRJA-nuus", "Izindaba ezintsha ze-WRJA"]
+    : ["New WRJA event", "Nuwe WRJA-geleentheid", "Umcimbi omusha we-WRJA"];
+  const body = `${title}${kind === "event" && item.date ? ` · ${item.date}` : ""}`.slice(0, 300);
+  return {
+    topic: TOPIC,
+    // Data messages let Android select its saved language in foreground/background.
+    // Content titles are user-authored and are not automatically translated.
+    data: {
+      type: kind, publication_id: id, title: headings[0], body,
+      title_en: headings[0], title_af: headings[1], title_zu: headings[2],
+      body_en: body, body_af: body, body_zu: body,
+    },
+    android: { priority: "high", ttl: "86400s" },
+  };
+}
+
+function credentials(env) {
+  if (env.FCM_NOTIFICATIONS_ENABLED !== "true") return null;
+  const projectId = String(env.FIREBASE_PROJECT_ID || "").trim();
+  const email = String(env.FIREBASE_CLIENT_EMAIL || "").trim();
+  const privateKey = String(env.FIREBASE_PRIVATE_KEY || "").replace(/\\n/g, "\n");
+  if (!/^[a-z][a-z0-9-]{4,62}$/.test(projectId) || !email.endsWith(".gserviceaccount.com") || !privateKey.includes("-----BEGIN PRIVATE KEY-----")) {
+    throw new Error("FCM server configuration is incomplete");
+  }
+  return { projectId, email, privateKey };
+}
+
+async function accessToken(config, fetchImpl) {
+  const identity = `${config.projectId}:${config.email}`;
+  if (cachedToken?.identity === identity && cachedToken.expiresAt > Date.now() + 60_000) return cachedToken.value;
+  if (tokenRequest) return tokenRequest;
+  tokenRequest = (async () => {
+    const now = Math.floor(Date.now() / 1000);
+    const encode = (value) => Buffer.from(JSON.stringify(value)).toString("base64url");
+    const unsigned = `${encode({ alg: "RS256", typ: "JWT" })}.${encode({
+      iss: config.email, scope: "https://www.googleapis.com/auth/firebase.messaging",
+      aud: TOKEN_URL, iat: now, exp: now + 3600,
+    })}`;
+    const signature = createSign("RSA-SHA256").update(unsigned).end().sign(config.privateKey, "base64url");
+    const response = await fetchImpl(TOKEN_URL, {
+      method: "POST", signal: AbortSignal.timeout(8000),
+      headers: { "Content-Type": "application/x-www-form-urlencoded" },
+      body: new URLSearchParams({ grant_type: "urn:ietf:params:oauth:grant-type:jwt-bearer", assertion: `${unsigned}.${signature}` }),
+    });
+    if (!response.ok) throw new Error("FCM OAuth failed");
+    const token = await response.json();
+    if (!token.access_token) throw new Error("FCM OAuth token missing");
+    cachedToken = { identity, value: token.access_token, expiresAt: Date.now() + Number(token.expires_in || 3600) * 1000 };
+    return cachedToken.value;
+  })();
+  try { return await tokenRequest; } finally { tokenRequest = null; }
+}
+
+// Awaited within the Vercel request, never fire-and-forget after res.json().
+// A push failure must not turn a successfully saved publication into an HTTP
+// failure (which could cause the administrator to create a duplicate record).
+export async function notifyPublication(kind, item, { env = process.env, fetchImpl = fetch, logger = console } = {}) {
+  try {
+    const config = credentials(env);
+    if (!config) return { status: "disabled" };
+    const token = await accessToken(config, fetchImpl);
+    const response = await fetchImpl(`https://fcm.googleapis.com/v1/projects/${config.projectId}/messages:send`, {
+      method: "POST", signal: AbortSignal.timeout(8000),
+      headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
+      body: JSON.stringify({ message: buildPublicationMessage(kind, item) }),
+    });
+    if (!response.ok) {
+      if (response.status === 401) cachedToken = null;
+      throw new Error("FCM send rejected");
+    }
+    const result = await response.json();
+    if (!result.name) throw new Error("FCM acknowledgement missing");
+    return { status: "accepted", messageId: result.name };
+  } catch (_) {
+    // Never log OAuth assertions, keys, tokens, or raw responses.
+    logger.warn("FCM publication notification failed; publication remains saved.", { kind, id: String(item?.id || "") });
+    return { status: "failed" };
+  }
+}
+
+/** Keeps the database write and notification ordering testable without network. */
+export async function saveAndNotify(kind, save, notify = notifyPublication) {
+  const item = await save();
+  let notification;
+  try { notification = await notify(kind, item); }
+  catch (_) { notification = { status: "failed" }; }
+  return { item, notification };
+}
diff --git a/backend/tests/push-notifications.test.js b/backend/tests/push-notifications.test.js
new file mode 100644
--- /dev/null
+++ b/backend/tests/push-notifications.test.js
@@ -0,0 +1,56 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { generateKeyPairSync } from "node:crypto";
+import { buildPublicationMessage, notifyPublication, saveAndNotify } from "../src/integrations/pushNotifications.js";
+
+describe("publication notifications", () => {
+  it("saves before attempting the notification", async () => {
+    const calls = [];
+    const result = await saveAndNotify("event", async () => { calls.push("saved"); return { id: "1", name: "Grading" }; }, async () => { calls.push("notified"); return { status: "accepted" }; });
+    assert.deepEqual(calls, ["saved", "notified"]);
+    assert.equal(result.item.id, "1");
+  });
+  it("never notifies when the database save fails", async () => {
+    let notified = false;
+    await assert.rejects(saveAndNotify("news", async () => { throw new Error("Database failed"); }, async () => { notified = true; }));
+    assert.equal(notified, false);
+  });
+  it("keeps the saved publication successful when sending fails", async () => {
+    const result = await saveAndNotify("news", async () => ({ id: "saved" }), async () => { throw new Error("Push failed"); });
+    assert.equal(result.item.id, "saved");
+    assert.equal(result.notification.status, "failed");
+  });
+  it("supports event and news contracts, multilingual headings, and no private data", () => {
+    for (const kind of ["event", "news"]) {
+      const payload = buildPublicationMessage(kind, { id: "1", title: "Public title", date: "2026-12-12", email: "private@example.com" });
+      assert.equal(payload.topic, "wrja-public-updates");
+      assert.ok(payload.data.title_af && payload.data.title_zu);
+      assert.equal(payload.notification, undefined);
+      assert.ok(!JSON.stringify(payload).includes("private@example.com"));
+    }
+  });
+  it("does not call Google while disabled", async () => {
+    const result = await notifyPublication("news", { id: "1", title: "News" }, { env: {}, fetchImpl: () => { throw new Error("Unexpected network"); } });
+    assert.equal(result.status, "disabled");
+  });
+  it("uses OAuth and FCM with a generated test key, not a real service account", async () => {
+    const { privateKey } = generateKeyPairSync("rsa", { modulusLength: 2048, privateKeyEncoding: { type: "pkcs8", format: "pem" }, publicKeyEncoding: { type: "spki", format: "pem" } });
+    const env = { FCM_NOTIFICATIONS_ENABLED: "true", FIREBASE_PROJECT_ID: "wrja-test-project", FIREBASE_CLIENT_EMAIL: "test@wrja-test-project.iam.gserviceaccount.com", FIREBASE_PRIVATE_KEY: privateKey };
+    const calls = [];
+    const result = await notifyPublication("news", { id: "1", title: "News" }, { env, fetchImpl: async (url, request) => {
+      calls.push(url);
+      if (url.includes("oauth2")) return { ok: true, json: async () => ({ access_token: "mock-token", expires_in: 3600 }) };
+      assert.equal(request.headers.Authorization, "Bearer mock-token");
+      assert.equal(JSON.parse(request.body).message.topic, "wrja-public-updates");
+      return { ok: true, json: async () => ({ name: "projects/test/messages/test" }) };
+    } });
+    assert.equal(result.status, "accepted");
+    assert.equal(calls.length, 2);
+  });
+  it("does not fail or expose secrets on invalid credentials", async () => {
+    const logs = [];
+    const result = await notifyPublication("news", { id: "1", title: "News" }, { env: { FCM_NOTIFICATIONS_ENABLED: "true", FIREBASE_PRIVATE_KEY: "secret-sentinel" }, logger: { warn: (...args) => logs.push(args) } });
+    assert.equal(result.status, "failed");
+    assert.ok(!JSON.stringify(logs).includes("secret-sentinel"));
+  });
+});
diff --git a/backend/FCM_SETUP.md b/backend/FCM_SETUP.md
new file mode 100644
--- /dev/null
+++ b/backend/FCM_SETUP.md
@@ -0,0 +1,40 @@
+# Automatic WRJA event/news alerts (production backend)
+
+## Deployment confirmed
+
+`vercel.json` rewrites `/api/*` to `api/index.js`, which exports `backend/src/server.js`. The deployed `/api/health` endpoint also responds with `Server: Vercel` and `X-Vercel-Id`. The downloaded folder is a source snapshot, not a connected Git checkout; deploy these changes through the website's real production repository/project, not the Android `app` branch.
+
+## Trigger behaviour
+
+Admin POST creation routes for standard events, competitions, school competitions and news now await `saveAndNotify`. The existing save publishes these records immediately. A push is attempted only after that save succeeds. PUT edits, DELETE requests, failed validation and failed database writes do not send alerts. No old records are broadcast when the app/server starts.
+
+FCM HTTP v1 targets `wrja-public-updates` in Firebase project `wrja-project`. Public content titles are retained in their authored language. Headings have English, Afrikaans and isiZulu variants; Android chooses its saved language. Supabase remains the database.
+
+The admin create response includes `notification.status`: `accepted` (Google accepted the request, not proof of delivery to every device), `disabled`, or `failed`. Notification failures never undo a saved record. Do not recreate a publication just to retry a failed alert. This integration deliberately has no automatic push retries on ambiguous failures, because FCM does not promise exactly-once delivery. Ordinary edits do not resend. A durable transactional notification outbox is a separate enhancement if guaranteed processing/retry is needed.
+
+The sender is awaited before returning the HTTP response: no in-memory timers, background subscriptions, or fire-and-forget work that Vercel might stop. OAuth and FCM each have an 8-second timeout. Warm function instances cache short-lived OAuth access tokens. There are no new npm dependencies; Node 20+ supplies fetch, crypto and AbortSignal.timeout.
+
+## What the project owner must configure
+
+1. In Firebase Console select **WRJA Project** (`wrja-project`) > **Project settings > Service accounts**. If using a downloadable key, select **Generate new private key**. Keep this JSON file private on your computer; it is NOT `google-services.json` and must never go in Android, frontend code, Git or chat. Prefer a dedicated least-privileged service account with Firebase Cloud Messaging API Admin permission for this project rather than a broadly privileged key.
+2. In the corresponding Google Cloud project confirm **Firebase Cloud Messaging API** (HTTP v1) is enabled. The Firebase Console test already established working client delivery, but the backend service identity must also have permission to send.
+3. Open the website's **Vercel project > Settings > Environment Variables**. Add these for **Production**, using the matching properties from the private service-account JSON:
+
+   | Variable | Value |
+   | --- | --- |
+   | `FCM_NOTIFICATIONS_ENABLED` | `true` |
+   | `FIREBASE_PROJECT_ID` | `wrja-project` (the key file's `project_id`) |
+   | `FIREBASE_CLIENT_EMAIL` | The key file's `client_email` |
+   | `FIREBASE_PRIVATE_KEY` | The complete `private_key`, including BEGIN/END lines; real newlines or literal `\n` are supported |
+
+   Never prefix these with `VITE_`: that would risk exposing them to the browser. Leave preview/development notifications disabled so test publications do not broadcast to production users. Missing/disabled configuration does not stop content publishing.
+4. Merge/deploy the changed website files to the branch connected to the Vercel production project, then redeploy after setting environment variables. Editing a downloaded folder does not update the live website. Verify the Vercel project actually points to the intended production branch; the local configuration alone cannot reveal that dashboard setting.
+5. On the phone enable Club notifications. Publish one intentional event/news article through the website admin. Confirm the API response has `notification.status = accepted` and the phone receives the alert in foreground and background. Check that editing the same record causes no new alert. Do not publish test content to all subscribers without considering the audience.
+
+## Verification
+
+`node --test backend/tests/push-notifications.test.js` uses generated temporary test keys and mocked network responses; it does not contact Google, send notifications, or touch Supabase. Run the website's full `npm test` from `backend` after installing its normal dependencies, and build the frontend before deployment.
+
+Server authentication is not an Android code change. The Android test-token copy button is for development only; never put a device token or Firebase service key in this documentation.
+
+References: https://firebase.google.com/docs/cloud-messaging/send/v1-api and https://developers.google.com/identity/protocols/oauth2/service-account
